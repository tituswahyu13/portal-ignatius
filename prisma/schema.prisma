// Prisma Schema for Portal Ignatius
// Converted from MySQL DDL (Dokumen 01) to PostgreSQL/Prisma
// Database: Supabase (PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. MASTER WILAYAH & LINGKUNGAN
// ============================================================

model Lingkungan {
  id             Int      @id @default(autoincrement())
  namaLingkungan String   @map("nama_lingkungan") @db.VarChar(100)
  wilayah        String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  users       User[]
  dataUmat    DataUmat[]
  kpsData     KpsData[]
  umkmData    UmkmData[]
  spbRequests SpbRequest[]

  @@map("lingkungan")
}

// ============================================================
// 2. USERS & RBAC (APP-AWARE)
// ============================================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int     @id @default(autoincrement())
  appModule   String  @map("app_module") @db.VarChar(50) // e.g., 'GLOBAL', 'DANSOSPAR', 'DATAUMAT'
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(100)
  email            String   @unique @db.VarChar(100)
  passwordHash     String   @map("password_hash") @db.VarChar(255)
  phoneNumber      String?  @map("phone_number") @db.VarChar(20)
  lingkunganId     Int?     @map("lingkungan_id")
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  lingkungan         Lingkungan?         @relation(fields: [lingkunganId], references: [id])
  userRoles          UserRole[]
  spbRequests        SpbRequest[]        @relation("SpbCreator")
  updatedSpbRequests SpbRequest[]        @relation("SpbUpdater")
  deletedSpbRequests SpbRequest[]        @relation("SpbDeleter")
  financialMutations FinancialMutation[] @relation("MutationCreator")
  updatedMutations   FinancialMutation[] @relation("MutationUpdater")
  deletedMutations   FinancialMutation[] @relation("MutationDeleter")
  createdRecurring   RecurringSpb[]      @relation("RecurringCreator")
  createdKps         KpsData[]           @relation("KpsCreator")
  updatedKps         KpsData[]           @relation("KpsUpdater")
  deletedKps         KpsData[]           @relation("KpsDeleter")
  createdUmkm        UmkmData[]          @relation("UmkmCreator")
  updatedUmkm        UmkmData[]          @relation("UmkmUpdater")
  deletedUmkm        UmkmData[]          @relation("UmkmDeleter")
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@map("users")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// 3. DATA SUBJEK (KPS & UMKM)
// ============================================================

model DataUmat {
  id              BigInt    @id @default(autoincrement())
  nama            String    @db.VarChar(150)
  namaBaptis      String?   @map("nama_baptis") @db.VarChar(100)
  jenisKelamin    String?   @map("jenis_kelamin") @db.VarChar(1)
  kkEncrypted     String?   @map("kk_encrypted") @db.VarChar(255)
  nikEncrypted    String?   @map("nik_encrypted") @db.VarChar(255)
  noHp            String?   @map("no_hp") @db.VarChar(20)
  tanggalLahir    DateTime? @map("tanggal_lahir") @db.Date
  lingkunganId    Int?      @map("lingkungan_id")
  alamat          String?   @db.Text
  agama           String?   @db.VarChar(50)
  statusNikah     String?   @map("status_nikah") @db.VarChar(50)
  pendidikan      String?   @db.VarChar(50)
  pekerjaan       String?   @db.VarChar(100)
  profesi         String?   @db.VarChar(100)
  kondisiTubuh    String?   @map("kondisi_tubuh") @db.VarChar(50)
  statusRumah     String?   @map("status_rumah") @db.VarChar(50)
  suku            String?   @db.VarChar(50)
  statusAktivitas String?   @map("status_aktivitas") @db.VarChar(50)
  kota            String?   @db.VarChar(50)
  kecamatan       String?   @db.VarChar(50)
  kelurahan       String?   @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  lingkungan      Lingkungan? @relation(fields: [lingkunganId], references: [id])
  kpsData         KpsData?
  umkmData        UmkmData[]

  @@map("data_umat")
}

model KpsData {
  id                  BigInt    @id @default(autoincrement())
  umatId              BigInt    @unique @map("umat_id")
  lingkunganId        Int       @map("lingkungan_id")
  skorPekerjaan       Int       @default(0) @map("skor_pekerjaan")
  skorSandang         Int       @default(0) @map("skor_sandang")
  skorPangan          Int       @default(0) @map("skor_pangan")
  skorPapan           Int       @default(0) @map("skor_papan")
  skorKesehatan       Int       @default(0) @map("skor_kesehatan")
  skorPendidikan      Int       @default(0) @map("skor_pendidikan")
  skorSosial          Int       @default(0) @map("skor_sosial")
  totalSkor           Int       @default(0) @map("total_skor")
  persentaseKelayakan Decimal   @default(0) @map("persentase_kelayakan") @db.Decimal(5, 2)
  statusKeluarga      String    @default("Prasejahtera") @map("status_keluarga") @db.VarChar(50)
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           BigInt?   @map("created_by")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  updatedBy           BigInt?   @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  deletedBy           BigInt?   @map("deleted_by")

  // Relations
  creator      User?          @relation("KpsCreator", fields: [createdBy], references: [id])
  updater      User?          @relation("KpsUpdater", fields: [updatedBy], references: [id])
  deleter      User?          @relation("KpsDeleter", fields: [deletedBy], references: [id])
  lingkungan   Lingkungan     @relation(fields: [lingkunganId], references: [id])
  umat         DataUmat       @relation(fields: [umatId], references: [id])
  spbRequests  SpbRequest[]
  recurringSpb RecurringSpb[]
  umkmData     UmkmData[]

  @@map("kps_data")
}

model UmkmData {
  id              BigInt    @id @default(autoincrement())
  umatId          BigInt    @map("umat_id")
  lingkunganId    Int       @map("lingkungan_id")
  namaUsaha       String    @map("nama_usaha") @db.VarChar(150)
  jenisUsaha      String?   @map("jenis_usaha") @db.VarChar(100)
  asetTotal       Decimal?  @map("aset_total") @db.Decimal(15, 2)
  omsetTahunan    Decimal?  @map("omset_tahunan") @db.Decimal(15, 2)
  nib             String?   @db.VarChar(50)
  nikEncrypted    String?   @map("nik_encrypted") @db.VarChar(255)
  kpsId           BigInt?   @map("kps_id")
  statusKelayakan Boolean   @default(true) @map("status_kelayakan")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       BigInt?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       BigInt?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       BigInt?   @map("deleted_by")
  googleDriveFileId String? @map("google_drive_file_id") @db.VarChar(255)
  
  // New Operational Fields
  alamatUsaha       String?   @map("alamat_usaha") @db.Text
  kategoriUsaha     String?   @map("kategori_usaha") @db.VarChar(50) // Produksi, Perdagangan, Jasa
  deskripsiUsaha    String?   @map("deskripsi_usaha") @db.Text
  keberadaanUsaha   Boolean?  @map("keberadaan_usaha") // true: Sudah ada, false: Belum ada
  kondisiUsahaSaatIni String? @map("kondisi_usaha_saat_ini") @db.Text
  keahlian          String?   @map("keahlian") @db.Text
  pengalamanUsahaSebelumnya String? @map("pengalaman_usaha_sebelumnya") @db.Text
  pelatihanKeuangan Boolean?  @map("pelatihan_keuangan") // true: Sudah mengikuti, false: Belum mengikuti
  anggotaPaguyuban  Boolean?  @map("anggota_paguyuban") // true: Ya, false: Tidak
  analisaUsaha      String?   @map("analisa_usaha") @db.VarChar(100) // Ada dan jelas, Ada tetapi tidak jelas, Tidak ada

  // Relations
  creator     User?        @relation("UmkmCreator", fields: [createdBy], references: [id])
  updater     User?        @relation("UmkmUpdater", fields: [updatedBy], references: [id])
  deleter     User?        @relation("UmkmDeleter", fields: [deletedBy], references: [id])
  lingkungan  Lingkungan   @relation(fields: [lingkunganId], references: [id])
  umat        DataUmat     @relation(fields: [umatId], references: [id])
  kpsData     KpsData?     @relation(fields: [kpsId], references: [id])
  spbRequests SpbRequest[]

  @@map("umkm_data")
}

// ============================================================
// 4. KEUANGAN & INTENSI
// ============================================================

enum MutationType {
  IN
  OUT
}

enum SourceType {
  KOLEKTE
  PERSEMBAHAN_BULANAN
  APP
  DONASI
  SPB_REALIZATION
  INTER_TRANSFER
}

model IntensiAccount {
  id          Int     @id @default(autoincrement())
  kodeAccount String  @unique @map("kode_account") @db.VarChar(20)
  namaIntensi String  @map("nama_intensi") @db.VarChar(100)
  saldo       Decimal @default(0.00) @db.Decimal(15, 2)

  // Relations
  financialMutations FinancialMutation[]
  spbRequests        SpbRequest[]
  recurringSpbs      RecurringSpb[]

  @@map("intensi_accounts")
}

model FinancialMutation {
  id              BigInt       @id @default(autoincrement())
  intensiId       Int          @map("intensi_id")
  type            MutationType
  amount          Decimal      @db.Decimal(15, 2)
  sourceType      SourceType   @map("source_type")
  referenceId     String?      @map("reference_id") @db.VarChar(100)
  description     String?      @db.Text
  createdBy       BigInt?      @map("created_by")
  transactionDate DateTime     @default(now()) @map("transaction_date")
  updatedAt       DateTime?    @updatedAt @map("updated_at")
  updatedBy       BigInt?      @map("updated_by")
  deletedAt       DateTime?    @map("deleted_at")
  deletedBy       BigInt?      @map("deleted_by")

  // Relations
  intensiAccount IntensiAccount @relation(fields: [intensiId], references: [id])
  creator        User?          @relation("MutationCreator", fields: [createdBy], references: [id])
  updater        User?          @relation("MutationUpdater", fields: [updatedBy], references: [id])
  deleter        User?          @relation("MutationDeleter", fields: [deletedBy], references: [id])

  @@map("financial_mutations")
}

// ============================================================
// 5. SURAT PERMOHONAN BANTUAN (SPB) & APPROVAL
// ============================================================

model RecurringSpb {
  id                 BigInt   @id @default(autoincrement())
  kpsId              BigInt   @map("kps_id")
  intensiId          Int      @map("intensi_id")
  kategoriBantuan    String   @map("kategori_bantuan") @db.VarChar(50)
  nominalBantuan     Decimal  @map("nominal_bantuan") @db.Decimal(15, 2)
  isActive           Boolean  @default(true) @map("is_active")
  lastGeneratedMonth String?  @map("last_generated_month") @db.VarChar(7) // YYYY-MM
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          BigInt   @map("created_by")

  // Relations
  kpsData        KpsData        @relation(fields: [kpsId], references: [id], onDelete: Cascade)
  intensiAccount IntensiAccount @relation(fields: [intensiId], references: [id])
  creator        User           @relation("RecurringCreator", fields: [createdBy], references: [id])

  @@map("recurring_spb")
}

enum SpbStatus {
  SUBMITTED
  REVIEW_PIC
  APPROVED_TPDSP
  REJECTED
  APPROVED_PASTOR
  REALIZED
}

model SpbRequest {
  id                     BigInt    @id @default(autoincrement())
  nomorSpb               String    @unique @map("nomor_spb") @db.VarChar(100)
  lingkunganId           Int       @map("lingkungan_id")
  kpsId                  BigInt?   @map("kps_id")
  umkmId                 BigInt?   @map("umkm_id")
  intensiId              Int       @map("intensi_id")
  kategoriBantuan        String    @map("kategori_bantuan") @db.VarChar(50)
  totalBiaya             Decimal   @map("total_biaya") @db.Decimal(15, 2)
  danaSwadaya            Decimal   @default(0) @map("dana_swadaya") @db.Decimal(15, 2)
  danaLingkungan         Decimal   @default(0) @map("dana_lingkungan") @db.Decimal(15, 2)
  danaParokiRequested    Decimal   @map("dana_paroki_requested") @db.Decimal(15, 2)
  danaParokiApproved     Decimal?  @map("dana_paroki_approved") @db.Decimal(15, 2)
  rekomendasiKevikepan   Boolean   @default(false) @map("rekomendasi_kevikepan")
  danaKevikepanRequested Decimal   @default(0) @map("dana_kevikepan_requested") @db.Decimal(15, 2)
  keaktifanUmat          String?   @map("keaktifan_umat") @db.VarChar(50)
  alasanBantuan          String?   @map("alasan_bantuan") @db.Text
  status                 SpbStatus @default(SUBMITTED)
  rejectionReason        String?   @map("rejection_reason") @db.Text
  createdBy              BigInt    @map("created_by")
  submittedAt            DateTime  @default(now()) @map("submitted_at")
  updatedAt              DateTime? @updatedAt @map("updated_at")
  updatedBy              BigInt?   @map("updated_by")
  deletedAt              DateTime? @map("deleted_at")
  deletedBy              BigInt?   @map("deleted_by")

  // Relations
  lingkungan     Lingkungan      @relation(fields: [lingkunganId], references: [id])
  kpsData        KpsData?        @relation(fields: [kpsId], references: [id])
  umkmData       UmkmData?       @relation(fields: [umkmId], references: [id])
  intensiAccount IntensiAccount  @relation(fields: [intensiId], references: [id])
  creator        User            @relation("SpbCreator", fields: [createdBy], references: [id])
  updater        User?           @relation("SpbUpdater", fields: [updatedBy], references: [id])
  deleter        User?           @relation("SpbDeleter", fields: [deletedBy], references: [id])
  attachments    SpbAttachment[]
  skDocuments    SkDocument[]

  @@map("spb_requests")
}

// Note: Menggunakan google_drive_file_id untuk storage (Dokumen 04)
model SpbAttachment {
  id                BigInt   @id @default(autoincrement())
  spbId             BigInt   @map("spb_id")
  fileType          String   @map("file_type") @db.VarChar(50)
  googleDriveFileId String   @map("google_drive_file_id") @db.VarChar(255)
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  // Relations
  spbRequest SpbRequest @relation(fields: [spbId], references: [id], onDelete: Cascade)

  @@map("spb_attachments")
}

model SkDocument {
  id                     BigInt   @id @default(autoincrement())
  nomorSk                String   @unique @map("nomor_sk") @db.VarChar(100)
  spbId                  BigInt   @map("spb_id")
  totalApprovedParoki    Decimal  @map("total_approved_paroki") @db.Decimal(15, 2)
  totalApprovedKevikepan Decimal  @default(0) @map("total_approved_kevikepan") @db.Decimal(15, 2)
  qrHash                 String   @map("qr_hash") @db.VarChar(255) // SHA-256 for QR verification
  pdfGoogleDriveId       String   @map("pdf_google_drive_id") @db.VarChar(255)
  createdAt              DateTime @default(now()) @map("created_at")

  // Relations
  spbRequest SpbRequest @relation(fields: [spbId], references: [id])

  @@map("sk_documents")
}

// ============================================================
// 6. LOG & NOTIFICATIONS (RBAC & AUDIT)
// ============================================================

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(150)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
